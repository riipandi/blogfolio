---
import { Icon } from 'astro-iconset/components'
/**
 * Homepage "Latest Writing" section: quiet typographic rows for the
 * most recent posts. Deliberately NOT another card grid — the hero
 * and Selected Work already carry imagery; this section adds a
 * typographic counter-rhythm using the same hairline-row vocabulary
 * as the "Keep reading" list on the single-post page.
 */
import { extractPlainText } from 'emdash'
import SectionHeader from '#/components/SectionHeader.astro'
import { formatDate } from '#/utils/format'

const WORDS_PER_MINUTE = 200

/** Reading time from Portable Text or plain content, e.g. "4 min read". */
const readingTime = (content: unknown): string => {
  const text = extractPlainText(content as Parameters<typeof extractPlainText>[0])
  const words = text.trim() ? text.trim().split(/\s+/).length : 0
  if (words === 0) return ''
  return `${Math.max(1, Math.round(words / WORDS_PER_MINUTE))} min read`
}

interface PostEntry {
  id: string
  data: {
    title?: string
    publishedAt?: unknown
    content?: unknown
    terms?: { category?: Array<{ label: string; slug: string }> }
  }
}
interface Props {
  posts: PostEntry[]
}
const { posts } = Astro.props
---

{posts.length > 0 && (
  <section class="home-writing rise" style="--rise-index: 3">
    <SectionHeader
      title="Latest Writing"
      href="/posts"
      linkLabel="View all posts →"
      class="rise"
      style="--rise-index: 4"
    />
    <ul class="writing-list rise" style="--rise-index: 5">
      {posts.map((post) => {
        const category = post.data.terms?.category?.[0]
        const date = formatDate(post.data.publishedAt)
        const time = readingTime(post.data.content)
        return (
          <li class="writing-row">
            <a href={`/posts/${post.id}`} class="writing-row-link">
              <span class="writing-meta">
                {date}
                {category && (
                  <span class="meta-sep" aria-hidden="true">
                    ·
                  </span>
                )}
                {category && category.label}
              </span>
              <span class="writing-row-title">{post.data.title}</span>
              {time && <span class="writing-time">{time}</span>}
              <Icon name="keyline-icons:arrow-up-right" aria-hidden="true" />
            </a>
          </li>
        )
      })}
    </ul>
  </section>
)}

<style>
  .home-writing {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-4xl);
  }

  /* Rows span the same column as the section header above them —
     matching the Selected Work section's full-width rhythm. */
  .writing-list {
    margin-top: var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  .writing-row + .writing-row {
    border-top: 1px solid var(--color-border);
  }

  .writing-row-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--spacing-sm) var(--spacing-lg);
    padding-block: var(--spacing-md);
    text-decoration: none;
  }

  .writing-meta {
    grid-column: 1 / -1;
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    letter-spacing: var(--tracking-wide);
  }

  .meta-sep {
    margin-inline: 0.45em;
    color: var(--color-border-strong);
  }

  /* Reading time rides the title line, one gutter left of the arrow. */
  .writing-time {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .writing-row-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-heading);
    line-height: var(--leading-snug);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .writing-row-link :global(svg) {
    width: 1.1em;
    height: 1.1em;
    color: var(--color-muted);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .writing-row-link:hover .writing-row-title {
    color: var(--color-muted);
  }

  /* Reading time follows the arrow's pattern: the secondary elements
     lift to ink while the primary title recedes. */
  .writing-row-link:hover .writing-time {
    color: var(--color-text);
  }

  .writing-row-link:hover :global(svg) {
    color: var(--color-text);
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .writing-row-title {
      line-height: var(--leading-normal);
    }

    .writing-row-link {
      padding-block: var(--spacing-lg);
    }
  }
</style>
