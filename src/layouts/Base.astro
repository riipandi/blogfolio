---
import { Icon } from 'astro-iconset/components'
import { Font } from 'astro:assets'
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from 'emdash'
import { createPublicPageContext } from 'emdash/page'
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from 'emdash/ui'
import LiveSearch from 'emdash/ui/search'
import TermsDialog from '#/components/TermsDialog.astro'
import { resolveStarterSiteIdentity } from '#/utils/site-identity'
import '#/styles/tokens.css'
import '#/styles/theme.css'

interface Props {
  title?: string
  pageTitle?: string | null
  description?: string | null
  image?: string | null
  canonical?: string | null
  robots?: string | null
  type?: 'website' | 'article'
  content?: { collection: string; id: string; slug?: string | null }
}

const {
  title,
  pageTitle,
  description,
  image,
  canonical,
  robots,
  type = 'website',
  content
} = Astro.props
const [settingsResult, menuResult, footerExploreResult, footerConnectResult] = await Promise.all([
  getSiteSettingsWithCacheHint(),
  getMenuWithCacheHint('primary'),
  getMenuWithCacheHint('footer_explore'),
  getMenuWithCacheHint('footer_connect')
])
const settings = settingsResult.data
const menu = menuResult.data

if (Astro.cache?.enabled) {
  for (const result of [settingsResult, menuResult, footerExploreResult, footerConnectResult]) {
    Astro.cache.set(result.cacheHint)
  }
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data)

const footerLinks = [footerExploreResult, footerConnectResult].flatMap(
  (result) => result.data?.items ?? []
)
const year = new Date().getFullYear()

const separator = settings?.seo?.titleSeparator || ' — '

const fullTitle = !title
  ? siteTitle
  : title === siteTitle || title.endsWith(` — ${siteTitle}`) || title.endsWith(` | ${siteTitle}`)
    ? title
    : `${title}${separator}${siteTitle}`
const siteDescription = settings?.tagline || 'Design & Development'

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.url.origin).href

const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? 'content' : 'custom',
  pageType: type,
  title: fullTitle,
  pageTitle: pageTitle ?? title ?? siteTitle,
  description: description || siteDescription,
  canonical: canonicalUrl,
  image,
  content,
  seo: { ogImage: image, robots },
  siteName: siteTitle
})

const isLoggedIn = Boolean(Astro.locals.user)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <EmDashHead page={pageCtx} />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteTitle} RSS Feed`}
      href="/rss.xml"
    />
    <script is:inline>
      // Apply an explicit theme choice immediately to prevent flash.
      // With no cookie, color-scheme: light dark follows the OS.
      ;(function () {
        var c = document.cookie
        var i = c.indexOf('theme=')
        var theme = i >= 0 ? c.slice(i + 6).split(';')[0] : null
        if (theme === 'dark' || theme === 'light') {
          document.documentElement.classList.add(theme)
        }
      })()
    </script>
  </head>
  <body>
    <EmDashBodyStart page={pageCtx} />
    <header class="site-header">
      <div class="nav">
        <a href="/" class="site-title">
          {siteLogo ? (
            <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" />
          ) : (
            siteTitle
          )}
        </a>
        <nav class="nav-links" aria-label="Primary">
          {menu?.items.map((item) => (
            <a
              href={item.url}
              target={item.target}
              rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="nav__actions">
          {isLoggedIn && (
            <a href="/_emdash/admin" class="nav-admin" title="Admin" aria-label="Admin">
              <Icon name="keyline-icons:app-window" aria-hidden="true" />
            </a>
          )}
          <LiveSearch
            class="nav-search"
            placeholder="Search"
            collections={['posts', 'pages', 'projects']}
            expandOnFocus={{ collapsed: '150px', expanded: '230px' }}
            showSnippets={false}
          />
          <button
            type="button"
            class="nav__menu-btn"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Menu"
          >
            <Icon name="keyline-icons:list" class="nav__menu-open" aria-hidden="true" />
            <Icon name="keyline-icons:x" class="nav__menu-close" aria-hidden="true" />
          </button>
        </div>
      </div>
      <nav id="mobile-menu" class="nav__panel" aria-label="Primary" hidden>
        <LiveSearch
          class="nav-panel-search"
          placeholder="Search"
          collections={['posts', 'pages', 'projects']}
          showSnippets={false}
        />
        {menu?.items.map((item) => (
          <a
            href={item.url}
            target={item.target}
            rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))}
        {isLoggedIn && (
          <a href="/_emdash/admin" class="nav-admin">
            Admin
          </a>
        )}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer__row">
          <div class="footer__brand">
            <a href="/" class="footer__logo">
              {siteLogo ? (
                <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="footer__logo-img" />
              ) : (
                siteTitle
              )}
            </a>
            {siteTagline && <p class="footer__tagline">{siteTagline}</p>}
          </div>
          <nav class="footer__links" aria-label="Footer">
            {footerLinks.map((item) => (
              <a
                href={item.url}
                target={item.target}
                rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                class="footer__link"
              >
                {item.label}
                {item.target === '_blank' && (
                  <Icon
                    name="keyline-icons:arrow-up-right"
                    class="footer__link-icon"
                    aria-hidden="true"
                  />
                )}
              </a>
            ))}
          </nav>
        </div>
        <div class="footer__meta">
          <p class="footer__copyright">
            &copy; {year} {siteTitle} &middot; Powered by&nbsp;
            <a href="https://emdashcms.com">EmDash</a>
          </p>
          <div class="theme-switcher" role="group" aria-label="Theme">
            <button
              type="button"
              class="theme-btn"
              data-theme="light"
              aria-pressed="false"
              title="Light mode"
              aria-label="Light mode"
            >
              <Icon name="keyline-icons:sun" aria-hidden="true" />
            </button>
            <button
              type="button"
              class="theme-btn"
              data-theme="dark"
              aria-pressed="false"
              title="Dark mode"
              aria-label="Dark mode"
            >
              <Icon name="keyline-icons:moon" aria-hidden="true" />
            </button>
            <button
              type="button"
              class="theme-btn"
              data-theme="system"
              aria-pressed="false"
              title="System theme"
              aria-label="System theme"
            >
              <Icon name="keyline-icons:monitor" aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>
      <div class="footer-inner">
        <div class="footer__wordmark" aria-hidden="true">
          <svg viewBox="0 0 1000 200" focusable="false" role="presentation">
            <defs>
              <linearGradient id="wordmark-fade" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" style="stop-color: var(--color-text); stop-opacity: 0.09;" />
                <stop offset="0.75" style="stop-color: var(--color-text); stop-opacity: 0.02;" />
              </linearGradient>
            </defs>
            <text
              x="500"
              y="155"
              text-anchor="middle"
              textLength="980"
              lengthAdjust="spacingAndGlyphs"
              font-size="200"
              letter-spacing="-9"
              font-weight="400"
              style={`font-family: var(--font-display), serif;`}
              fill="url(#wordmark-fade)"
            >
              {siteTitle}
            </text>
          </svg>
        </div>
      </div>
    </footer>
    <EmDashBodyEnd page={pageCtx} />
    <TermsDialog />

    <script>
      // Theme switcher
      const THEME_REGEX = /theme=([^;]+)/
      const themeBtns = document.querySelectorAll<HTMLButtonElement>('.theme-btn')
      const root = document.documentElement

      function setTheme(theme: string) {
        if (theme !== 'light' && theme !== 'dark' && theme !== 'system') {
          theme = 'system'
        }
        const secure = location.protocol === 'https:' ? '; Secure' : ''
        if (theme === 'system') {
          document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`
          root.classList.remove('light', 'dark')
        } else {
          document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`
          root.classList.remove('light', 'dark')
          root.classList.add(theme)
        }
        updateActiveBtn(theme)
      }

      function updateActiveBtn(theme: string) {
        themeBtns.forEach((btn) => {
          const active = btn.dataset.theme === theme
          btn.classList.toggle('active', active)
          btn.setAttribute('aria-pressed', String(active))
        })
      }

      function getStoredTheme(): string {
        const match = document.cookie.match(THEME_REGEX)
        return match?.[1] ?? 'system'
      }

      // Initialize - apply stored theme on load
      const storedTheme = getStoredTheme()
      setTheme(storedTheme)

      themeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          setTheme(btn.dataset.theme || 'system')
        })
      })

      // Mobile menu toggle
      const menuBtn = document.querySelector('.nav__menu-btn')
      const menuPanel = document.getElementById('mobile-menu')
      if (menuBtn && menuPanel) {
        menuBtn.addEventListener('click', () => {
          const open = menuBtn.getAttribute('aria-expanded') === 'true'
          menuBtn.setAttribute('aria-expanded', String(!open))
          menuPanel.hidden = open
        })
      }
    </script>

    <script>
      /* LiveSearch a11y patch. The stock emdash component binds its
			   Arrow/Enter/Escape handling to the input only, so once a
			   result is focused the arrows fall through to the page and
			   scroll it. This patch continues navigation from the result
			   list, closes on Escape, and adds the combobox/listbox ARIA
			   wiring the component lacks. */
      function enhanceLiveSearch(): void {
        document.querySelectorAll('emdash-live-search').forEach((host) => {
          if (host.hasAttribute('data-a11y-enhanced')) return
          const input = host.querySelector<HTMLInputElement>('input.emdash-live-search-input')
          const results = host.querySelector<HTMLElement>('.emdash-live-search-results')
          const listbox = host.querySelector<HTMLElement>('.emdash-live-search-results-list')
          if (!input || !results || !listbox) return
          host.setAttribute('data-a11y-enhanced', '')

          const listboxId = `emdash-ls-listbox-${Math.random().toString(36).slice(2, 8)}`
          listbox.id = listboxId
          input.setAttribute('role', 'combobox')
          input.setAttribute('aria-haspopup', 'listbox')
          input.setAttribute('aria-expanded', 'false')
          input.setAttribute('aria-autocomplete', 'list')
          input.setAttribute('aria-controls', listboxId)
          input.setAttribute('aria-keyshortcuts', '/')

          // aria-expanded mirrors the dropdown's hidden state.
          const syncExpanded = () =>
            input.setAttribute('aria-expanded', results.hasAttribute('hidden') ? 'false' : 'true')
          new MutationObserver(syncExpanded).observe(results, {
            attributes: true,
            attributeFilter: ['hidden']
          })
          syncExpanded()

          // Results are rendered per keystroke; stamp option roles
          // as they arrive.
          const stampOptions = () =>
            listbox.querySelectorAll('a.emdash-live-search-result').forEach((el) => {
              el.setAttribute('role', 'option')
            })
          new MutationObserver(stampOptions).observe(listbox, {
            childList: true,
            subtree: true
          })
          stampOptions()
        })
      }
      enhanceLiveSearch()
      new MutationObserver(enhanceLiveSearch).observe(document.body, {
        childList: true,
        subtree: true
      })

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== 'Escape') return
        const target = e.target as HTMLElement | null
        const results = target?.closest?.('.emdash-live-search-results')
        if (!results) return // input-side keys are the component's job

        if (e.key === 'Escape') {
          e.preventDefault()
          e.stopPropagation()
          // The component's input handler knows how to collapse the
          // dropdown. Deliberately no input.focus() afterwards:
          // the component's focus listener re-opens the dropdown
          // whenever a query is present, so refocusing would undo
          // the close (the component's own Escape blurs too).
          const input = results.parentElement?.querySelector<HTMLInputElement>(
            'input.emdash-live-search-input'
          )
          input?.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }))
          return
        }

        const items = Array.from(
          results.querySelectorAll<HTMLElement>('.emdash-live-search-result')
        )
        if (items.length === 0) return
        e.preventDefault()
        e.stopPropagation()

        const focusedIdx = items.findIndex(
          (el) => el === document.activeElement || el.classList.contains('focused')
        )
        items.forEach((el) => el.classList.remove('focused'))
        const nextIdx =
          focusedIdx === -1
            ? e.key === 'ArrowDown'
              ? 0
              : items.length - 1
            : (focusedIdx + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length
        const nextEl = items[nextIdx]
        if (!nextEl) return
        nextEl.classList.add('focused')
        nextEl.focus()
        // Keep the highlighted row visible inside the dropdown's
        // own scroll area without scrolling the page.
        nextEl.scrollIntoView({ block: 'nearest' })
      })

      /* "/" focuses the site search, the way docs sites do it.
			   Skips when the user is already typing somewhere; on mobile
			   it opens the menu panel that hosts the search first. */
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return
        const target = e.target as HTMLElement | null
        if (
          target?.closest?.(
            "input, textarea, select, [contenteditable='true'], [contenteditable='']"
          )
        )
          return
        e.preventDefault()

        let input = document.querySelector<HTMLInputElement>(
          '.site-header input.emdash-live-search-input'
        )
        if (!input || input.offsetParent === null) {
          const panel = document.getElementById('mobile-menu')
          if (panel?.hidden) {
            panel.hidden = false
            document.querySelector('.nav__menu-btn')?.setAttribute('aria-expanded', 'true')
          }
          input = document.querySelector<HTMLInputElement>(
            '.nav__panel input.emdash-live-search-input'
          )
        }
        if (input) {
          input.focus()
          input.select()
        }
      })

      /* Image grab deterrence: the stock <img> context menu offers
			   "Save image as…" on a plate. Block it on images and on the
			   media containers they sit in (right-clicking a transparent
			   overlay or a frame must not leak the image menu either).
			   This is deterrence, not DRM — a determined user with devtools
			   can still fetch assets; it just closes the easy road. */
      const isMedia = (el: EventTarget | null): Element | null =>
        el instanceof Element ? el.closest('img, .media-frame, .card-image, .more-thumb') : null
      document.addEventListener('contextmenu', (e) => {
        if (isMedia(e.target)) e.preventDefault()
      })
      document.addEventListener('dragstart', (e) => {
        if (isMedia(e.target)) e.preventDefault()
      })
    </script>

    <style is:global>
      /*
       * Establish layer order: "base" has lower priority than unlayered
       * styles, so theme.css overrides always win regardless of source
       * order in the bundled CSS.
       */
      @layer base;

      @layer base {
        *,
        *::before,
        *::after {
          box-sizing: border-box;
          margin: 0;
          padding: 0;
        }

        /*
      	 * Design tokens live in src/styles/tokens.css. Colors are
      	 * defined with light-dark(); these rules pin the scheme when
      	 * the footer switcher sets an explicit choice. With no class,
      	 * color-scheme: light dark follows the OS preference. The
      	 * @supports guard keeps the toggle from forcing dark UA form
      	 * controls on browsers stuck on the plain-light fallback.
      	 */
        @supports (color: light-dark(#000, #fff)) {
          :root.light {
            color-scheme: light;
          }

          :root.dark {
            color-scheme: dark;
          }
        }

        html {
          scroll-behavior: smooth;
        }

        body {
          font-family: var(--font-body);
          font-size: var(--font-size-base);
          line-height: var(--leading-normal);
          color: var(--color-text);
          background: var(--color-bg);
          -webkit-font-smoothing: antialiased;
          min-height: 100vh;
        }

        a {
          color: currentColor;
        }

        img {
          max-width: 100%;
          height: auto;
          display: block;
        }

        h1,
        h2,
        h3,
        h4 {
          font-family: var(--font-heading);
          font-weight: var(--font-weight-heading);
          line-height: var(--leading-snug);
        }

        h1 {
          font-size: var(--font-size-4xl);
        }

        h2 {
          font-size: var(--font-size-2xl);
        }

        h3 {
          font-size: var(--font-size-xl);
        }

        /* Motion
         *
         * Page-load entrance animation, adapted from the emdash-demo
         * sandbox. Pure CSS, no JS: `.rise` fades/slides elements in on
         * first paint with a stagger driven by `--rise-index` (set it
         * inline or via the grid loops), and `.settle` lets large media
         * ease from a slight zoom once it scrolls into view via the
         * scroll-driven `view()` timeline. Both are gated on
         * no-preference so reduced-motion users get static pages.
         * NOTE: these rules must stay in the <style is:global> block —
         * Astro scopes plain <style> selectors to this layout only, and
         * `.rise` lives on page markup. */

        @media (prefers-reduced-motion: no-preference) {
          .rise {
            animation: rise-in 700ms var(--ease-out) both;
            animation-delay: calc(var(--rise-index, 0) * 90ms);
          }

          @supports (animation-timeline: view()) {
            .settle img {
              animation: media-settle linear both;
              animation-timeline: view();
              animation-range: entry 0% cover 45%;
            }

            /* Text blocks that sit below the fold: same entrance as
             * .rise but driven by scroll position, so they come alive
             * as they enter the viewport instead of playing (and
             * finishing) before the user ever sees them. Only use this
             * on content guaranteed to start below the viewport — an
             * element already visible at load snaps straight to its
             * final state and looks static. */
            .reveal {
              animation: rise-in linear both;
              animation-timeline: view();
              animation-range: entry 0% entry 55%;
            }
          }
        }
      }

      @keyframes rise-in {
        from {
          opacity: 0;
          translate: 0 14px;
          filter: blur(6px);
        }
      }

      @keyframes media-settle {
        from {
          scale: 1.12;
        }

        to {
          scale: 1;
        }
      }
    </style>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        padding-block-start: 12px;
        padding-inline: var(--gutter);
        pointer-events: none;
      }

      .nav {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 16px;
        width: min(100%, calc(var(--wide-width) - 10px));
        height: 60px;
        margin-inline: auto;
        padding-inline: 24px 10px;
        border-radius: var(--radius-full);
        background: var(--glass-bg);
        box-shadow: var(--shadow-glass);
        -webkit-backdrop-filter: saturate(1.6) blur(18px);
        backdrop-filter: saturate(1.6) blur(18px);
        pointer-events: auto;
      }

      .site-title {
        grid-column: 1;
        justify-self: start;
        min-width: 0;
        overflow: hidden;
        font-family: var(--font-display);
        font-size: 26px;
        font-weight: var(--font-weight-display);
        line-height: 1.2;
        letter-spacing: -0.01em;
        text-decoration: none;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .site-logo-img {
        height: 32px;
        width: auto;
        max-width: 160px;
        object-fit: contain;
        display: block;
      }

      .nav-links {
        grid-column: 2;
        justify-self: center;
        display: flex;
        gap: 34px;
        font-size: 14.5px;
        color: var(--color-text-secondary);
      }

      .nav-links a {
        white-space: nowrap;
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      .nav-links a:hover {
        color: var(--color-text);
      }

      .nav-links a:empty {
        display: none;
      }

      /*
       * Admin is an icon button so it carries the same visual weight as
       * the search pill; on mobile it lives in the menu panel instead.
       * Scoped to .nav__actions so the panel's text "Admin" link stays
       * a normal panel row.
       */
      .nav__actions .nav-admin {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        color: var(--color-text-secondary);
        transition:
          background-color var(--transition-fast),
          color var(--transition-fast);
      }

      .nav__actions .nav-admin:hover {
        background: var(--color-sunken);
        color: var(--color-text);
      }

      .nav__actions .nav-admin svg {
        width: 20px;
        height: 20px;
      }

      .nav__actions {
        grid-column: 3;
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      /*
       * LiveSearch ships its own scoped styles, so these overrides use
       * element + class selectors to win on specificity. The dropdown
       * colors are themed through --emdash-search-* in theme.css.
       * .nav-search is rendered by the LiveSearch component, so it must
       * be targeted through :global() here.
       */
      .site-header :global(.nav-search) {
        flex: none;
        position: relative;
      }

      /* Keyboard affordance: a small "/" keycap pinned inside the
         pill's right edge, so people can discover the shortcut.
         It vanishes while the field is in use. */
      .site-header :global(.nav-search::after) {
        content: '/';
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        display: grid;
        place-items: center;
        width: 18px;
        height: 18px;
        font-size: 11px;
        line-height: 1;
        color: var(--color-muted);
        border: 1px solid var(--color-border);
        border-radius: 5px;
        pointer-events: none;
        transition: opacity var(--transition-fast);
      }

      .site-header :global(.nav-search:focus-within::after) {
        opacity: 0;
      }

      .site-header :global(input.emdash-live-search-input) {
        height: 36px;
        padding: 0 16px;
        border: 0;
        border-radius: var(--radius-full);
        background: var(--color-sunken);
        font-size: 14px;
        text-align: left;
        font-family: var(--font-body);
        color: var(--color-text);
        transition:
          background-color var(--transition-fast),
          box-shadow var(--transition-fast);
      }

      .site-header :global(input.emdash-live-search-input::placeholder) {
        color: var(--color-muted);
      }

      .site-header :global(input.emdash-live-search-input:focus) {
        outline: none;
        box-shadow: 0 0 0 2px var(--color-brand-ring);
      }

      /*
       * Search dropdown: right-anchored panel matching the pill language.
       * Element + class selectors beat the component's scoped styles.
       */
      .site-header :global(div.emdash-live-search-results) {
        top: calc(100% + 8px);
        left: auto;
        right: 0;
        width: min(340px, calc(100vw - 2 * var(--gutter) - 16px));
        padding: 6px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
      }

      .site-header :global(.emdash-live-search-loading),
      .site-header :global(.emdash-live-search-no-results) {
        padding: 18px 12px;
        font-size: 13px;
        text-align: center;
        color: var(--color-muted);
      }

      .site-header :global(div.emdash-live-search-results-list) {
        display: grid;
        gap: 2px;
      }

      /*
       * One row = title left, collection tag right on the same
       * baseline. Snippets are off (showSnippets={false}); the FTS
       * match usually repeats the title anyway.
       */
      .site-header :global(a.emdash-live-search-result) {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        column-gap: 12px;
        row-gap: 3px;
        padding: 10px 12px;
        border: 0;
        border-radius: var(--radius);
        transition: background-color var(--transition-fast);
      }

      .site-header :global(a.emdash-live-search-result:hover),
      .site-header :global(a.emdash-live-search-result:focus),
      .site-header :global(a.emdash-live-search-result.focused) {
        /* Sunken wash alone was too close to the dropdown surface;
      	   the hairline ring makes the selected row read as a distinct
      	   pill in both themes. */
        background: var(--color-sunken);
        box-shadow: inset 0 0 0 1px var(--color-border-strong);
        outline: none;
      }

      .site-header :global(a.emdash-live-search-result.focused .emdash-live-search-result-title) {
        color: var(--color-text);
      }

      .site-header :global(span.emdash-live-search-result-title) {
        font-size: 14px;
        font-weight: 500;
        line-height: var(--leading-snug);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .site-header :global(span.emdash-live-search-result-collection) {
        font-size: 11px;
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--color-muted);
      }

      .nav__menu-btn {
        display: none;
        place-items: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: none;
        color: inherit;
        cursor: pointer;
        transition: background-color var(--transition-fast);
      }

      .nav__menu-btn svg {
        width: 22px;
        height: 22px;
      }

      .nav__menu-btn .nav__menu-close {
        display: none;
      }

      .nav__menu-btn[aria-expanded='true'] .nav__menu-open {
        display: none;
      }

      .nav__menu-btn[aria-expanded='true'] .nav__menu-close {
        display: block;
      }

      .nav__panel {
        position: absolute;
        top: calc(100% + 8px);
        inset-inline: var(--gutter);
        display: none;
        padding: 8px;
        border-radius: var(--radius-lg);
        background: var(--glass-bg);
        box-shadow: var(--shadow-glass);
        -webkit-backdrop-filter: saturate(1.6) blur(18px);
        backdrop-filter: saturate(1.6) blur(18px);
        pointer-events: auto;
        max-height: calc(100dvh - 96px);
        overflow-y: auto;
      }

      .nav__panel:not([hidden]) {
        display: grid;
      }

      .nav__panel a {
        padding: 10px 14px;
        border-radius: var(--radius);
        font-size: 15px;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition:
          background-color var(--transition-fast),
          color var(--transition-fast);
      }

      .nav__panel a:hover {
        background: var(--color-sunken);
        color: var(--color-text);
      }

      /* Search lives in the panel on mobile, full width */
      .nav__panel :global(.emdash-live-search) {
        display: block;
        margin-bottom: 6px;
      }

      .nav__panel :global(input.emdash-live-search-input) {
        width: 100%;
      }

      main {
        min-height: calc(100vh - 200px);
      }

      .site-footer {
        overflow: hidden;
        border-top: 1px solid var(--color-border);
        padding-top: var(--spacing-2xl);
      }

      .footer-inner {
        max-width: var(--wide-width);
        margin: 0 auto;
        padding: 0 var(--spacing-lg);
      }

      .footer__row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px 32px;
      }

      .footer__logo {
        display: inline-block;
        font-family: var(--font-heading);
        font-size: 20px;
        font-weight: var(--font-weight-heading);
        line-height: 1;
        letter-spacing: var(--tracking-tight);
        text-decoration: none;
      }

      .footer__logo-img {
        width: auto;
        height: 28px;
        max-width: 160px;
        object-fit: contain;
      }

      .footer__tagline {
        margin-top: 8px;
        font-size: 13.5px;
        color: var(--color-muted);
      }

      .footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
      }

      .footer__link {
        font-size: 14px;
        color: var(--color-muted);
        overflow-wrap: anywhere;
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      .footer__link:hover {
        color: var(--color-text);
      }

      .footer__link-icon {
        width: 0.85em;
        height: 0.85em;
        margin-inline-start: 2px;
        vertical-align: baseline;
        opacity: 0.6;
      }

      .footer__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px 16px;
        margin-top: var(--spacing-xl);
        font-size: 13px;
        color: var(--color-muted);
      }

      .footer__copyright a {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 3px;
        transition: text-decoration-color var(--transition-fast);
      }

      .footer__copyright a:hover {
        text-decoration-color: currentColor;
      }

      .theme-switcher {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--color-text) 6%, transparent);
      }

      .theme-btn {
        display: grid;
        place-items: center;
        width: 32px;
        height: 28px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--color-muted);
        cursor: pointer;
        transition:
          background-color var(--transition-fast),
          color var(--transition-fast),
          box-shadow var(--transition-fast);
      }

      .theme-btn svg {
        width: 16px;
        height: 16px;
      }

      .theme-btn:hover {
        color: var(--color-text);
      }

      .theme-btn[aria-pressed='true'] {
        background: var(--color-surface);
        color: var(--color-text);
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
      }

      /*
       * The wordmark bleeds past the content column (115% wide,
       * centered) and is clipped by the footer's overflow: hidden.
       */
      .footer__wordmark {
        margin-top: 32px;
        margin-bottom: -16px;
        -webkit-user-select: none;
        user-select: none;
        pointer-events: none;
      }

      .footer__wordmark svg {
        display: block;
        width: 115%;
        margin-inline: -7.5%;
        height: auto;
      }

      @media (max-width: 880px) {
        .nav {
          gap: 16px;
          padding-inline-start: 20px;
        }

        /* Bar stays clean: logo + menu button only.
      	   Links, admin, and search live in the panel. */
        .nav-links,
        .nav__actions .nav-admin,
        .nav__actions :global(.nav-search) {
          display: none;
        }

        .nav__menu-btn {
          display: grid;
        }

        /*
      	 * In the panel the dropdown flows inline under the input
      	 * instead of floating as a narrow right-anchored overlay,
      	 * so the composition stays balanced at small widths.
      	 */
        .nav__panel :global(div.emdash-live-search-results) {
          position: static;
          width: auto;
          margin-top: 6px;
        }

        .nav__panel :global(a.emdash-live-search-result) {
          display: block;
        }

        /* Same selected-row treatment as the header dropdown. */
        .nav__panel :global(a.emdash-live-search-result:hover),
        .nav__panel :global(a.emdash-live-search-result:focus),
        .nav__panel :global(a.emdash-live-search-result.focused) {
          background: var(--color-sunken);
          box-shadow: inset 0 0 0 1px var(--color-border-strong);
          outline: none;
        }

        .nav__panel :global(a.emdash-live-search-result.focused .emdash-live-search-result-title) {
          color: var(--color-text);
        }

        .nav__panel :global(span.emdash-live-search-result-title) {
          white-space: normal;
          overflow-wrap: anywhere;
        }

        .footer__row {
          flex-direction: column;
          align-items: flex-start;
        }

        h1 {
          font-size: var(--font-size-3xl);
        }
      }

      @media (forced-colors: active) {
        .theme-btn[aria-pressed='true'] {
          outline: 1px solid CanvasText;
        }

        .footer__wordmark {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
