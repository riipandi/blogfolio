---
import { Icon } from 'astro-iconset/components'
import Base from '#/layouts/Base.astro'

const contactEmail = 'hello@studio.example'
---

<Base title="Contact" description="Get in touch about your next project.">
  <div class="contact-page">
    <header class="contact-header">
      <p class="contact-eyebrow rise">Start a conversation</p>
      <h1 class="contact-title rise" style="--rise-index: 1">
        Tell us about your project
      </h1>
      <p class="contact-intro rise" style="--rise-index: 2">
        Share what you are making, the problem you need to solve, and any timing you have in mind.
        We will reply by email.
      </p>
    </header>

    <section
      class="contact-card rise"
      style="--rise-index: 3"
      aria-labelledby="contact-email-heading"
    >
      <div>
        <h2 id="contact-email-heading">Email the studio</h2>
        <p>Use your email app to send the project details directly.</p>
      </div>
      <a class="contact-link" href={`mailto:${contactEmail}`}>
        {contactEmail}
        <Icon name="keyline-icons:arrow-up-right" class="contact-link-icon" aria-hidden="true" />
      </a>
    </section>
  </div>
</Base>
<style>
  .contact-page {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-4xl);
  }

  .contact-header {
    max-width: var(--max-width);
    margin-bottom: var(--spacing-3xl);
  }

  .contact-eyebrow {
    margin-bottom: var(--spacing-md);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .contact-title {
    margin-bottom: var(--spacing-lg);
    font-family: var(--font-display);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
  }

  .contact-intro {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-2xl);
    padding: var(--spacing-2xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .contact-card h2 {
    margin-bottom: var(--spacing-xs);
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-heading);
  }

  .contact-card p {
    color: var(--color-muted);
  }

  /* Pill button, same language as the nav search pill */
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-xl);
    color: var(--color-on-brand);
    background: var(--color-brand);
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: background var(--transition-fast);
  }

  .contact-link:hover {
    background: var(--color-brand-strong);
  }

  .contact-link-icon {
    width: 0.9em;
    height: 0.9em;
    transition: transform var(--transition-fast);
  }

  .contact-link:hover .contact-link-icon {
    transform: translate(2px, -2px);
  }

  @media (max-width: 880px) {
    .contact-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .contact-link {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
