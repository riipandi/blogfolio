---
import { Icon } from 'astro-iconset/components'
import {
  getTaxonomyTermsWithCacheHint,
  getEmDashCollection,
  getTermsForEntries,
  decodeSlug
} from 'emdash'
import PostCard from '#/components/PostCard.astro'
import Base from '#/layouts/Base.astro'
import { planBentoRows } from '#/utils/bento'

// Taxonomy names must match the seed exactly: the posts tag taxonomy
// is "tag", not "tag".
const slug = decodeSlug(Astro.params.slug)
const termsResult = await getTaxonomyTermsWithCacheHint('tag', {
  includeCounts: false
})
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null

if (!term) {
  return Astro.rewrite('/404')
}

const cursor = Astro.url.searchParams.get('cursor') || undefined
const {
  entries: posts,
  cacheHint,
  nextCursor
} = await getEmDashCollection('posts', {
  // The where key must match the taxonomy name exactly ("tag"),
  // the same key getEntriesByTerm() builds internally.
  where: { tag: term.slug },
  orderBy: { published_at: 'desc' },
  limit: 12,
  cursor
})

const tagsByEntry = await getTermsForEntries(
  'posts',
  posts.map((p) => p.data.id),
  'tag'
)
const postsWithTags = posts.map((post) => ({
  post,
  tags: tagsByEntry.get(post.data.id) ?? []
}))

const bentoRows = planBentoRows(postsWithTags)

if (Astro.cache?.enabled) {
  Astro.cache.set(termsResult.cacheHint)
  Astro.cache.set(cacheHint)
}
---

<Base title={`Posts tagged "${term.label}"`} description={`Posts tagged ${term.label}`}>
  <header class="archive-hero">
    <div class="archive-inner">
      <div class="archive-heading">
        <p class="archive-eyebrow rise">Tag</p>
        <h1 class="archive-title rise" style="--rise-index: 1">
          {term.label}
        </h1>
      </div>
      <nav class="archive-crumb" aria-label="Breadcrumb">
        <a href="/posts">All Posts</a>
        <span class="crumb-sep" aria-hidden="true">
          /
        </span>
        <span class="crumb-current" aria-current="page">
          {term.label}
        </span>
      </nav>
    </div>
  </header>

  <section class="archive-list">
    <div class="archive-inner">
      {postsWithTags.length === 0 ? (
        <div class="empty-state">
          <p>No posts with this tag yet.</p>
        </div>
      ) : (
        <div class="posts-grid">
          {bentoRows.map((row) => (
            <div
              class:list={[
                'bento-row',
                row.kind === 'wide' && 'bento-row--wide',
                row.kind === 'wide' && row.flip && 'bento-row--flip'
              ]}
            >
              {row.posts.map(({ post, tags }, idx) => (
                <PostCard
                  post={post}
                  tags={tags}
                  class={row.kind === 'wide' && idx === 0 ? 'post-card--wide' : undefined}
                />
              ))}
            </div>
          ))}
        </div>
      )}

      {(cursor || nextCursor) && (
        <nav class="posts-pagination" aria-label="Pagination">
          {cursor ? (
            <a href={`/tag/${term.slug}`} class="page-link">
              <Icon name="keyline-icons:arrow-left" aria-hidden="true" />
              First page
            </a>
          ) : (
            <span />
          )}
          {nextCursor && (
            <a
              href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
              class="page-link"
            >
              Next page
              <Icon name="keyline-icons:arrow-right" aria-hidden="true" />
            </a>
          )}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .archive-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding-inline: var(--spacing-lg);
  }

  .archive-hero {
    padding-block: var(--spacing-2xl) var(--spacing-lg);
  }

  .archive-hero .archive-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--spacing-md) var(--spacing-2xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .archive-heading {
    display: grid;
    gap: var(--spacing-xs);
  }

  .archive-eyebrow {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .archive-title {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
  }

  /* Breadcrumb sits at the title's baseline on the right, mirroring
     the posts-index hero composition. */
  .archive-crumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: 0.4em;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .archive-crumb a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .archive-crumb a:hover {
    color: var(--color-text);
  }

  /* The current page reads one step darker: you are here, without
     competing with the serif title. */
  .crumb-current {
    color: var(--color-text);
  }

  .crumb-sep {
    font-size: var(--font-size-xs);
    color: var(--color-border-strong);
  }

  .archive-list {
    padding-block: var(--spacing-2xl) var(--spacing-4xl);
  }

  .posts-grid {
    display: grid;
    gap: var(--spacing-3xl) var(--spacing-2xl);
  }

  .bento-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-3xl) var(--spacing-2xl);
    align-items: start;
  }

  .bento-row--wide {
    --post-media-h: clamp(240px, 24vw, 340px);
    --post-media-ar: auto;
  }

  .bento-row > :global(.post-card--wide) {
    grid-column: span 2;
  }

  /* `order`, not explicit grid lines: an explicit column on the wide
     card would push the auto-placed normal card to the next row and
     leave the first cell empty. */
  .bento-row--wide.bento-row--flip > :global(.post-card--wide) {
    order: 2;
  }

  .posts-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .page-link svg {
    width: 1em;
    height: 1em;
  }

  .page-link:hover {
    color: var(--color-text);
  }

  .empty-state {
    text-align: center;
    padding: var(--spacing-4xl) var(--spacing-lg);
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .archive-inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }

    /* Breadcrumb moves above the title on small screens. */
    .archive-crumb {
      order: -1;
      margin-bottom: 0;
    }

    .bento-row {
      grid-template-columns: 1fr;
    }

    .bento-row > :global(.post-card--wide) {
      grid-column: auto;
    }

    .bento-row--wide {
      --post-media-h: auto;
      --post-media-ar: 3 / 2;
    }
  }
</style>
